model {
  user = person 'User'

  workstation = softwareSystem 'Arch Linux workstation' {
    description 'The user’s personal Linux workstation and daily software environment. The website project and the menu repository are explicitly outside this system.'

    hardware = container 'Laptop hardware' {
      description 'MacBookAir6,2 platform: Intel Core i5-4260U, Intel Haswell graphics, Broadcom BCM4360 Wi-Fi, Apple trackpad.'
      laptop = component 'MacBook Air 6,2' {
        #confirmed
        description 'Physical host for the software environment.'
      }
      keyboard = inputDevice 'Apple Internal Keyboard' {
        #confirmed
        description 'Built-in Apple keyboard; earlier hardware inventory identified it as an internal USB HID device. Refresh the live kernel device path during machine audit.'
      }
      graphics = component 'Intel Haswell graphics' {
        #confirmed
        description 'Integrated Intel GPU used by the Wayland session.'
      }
      wifi = component 'Broadcom BCM4360 Wi-Fi' {
        #confirmed
        description 'Wireless adapter using broadcom-wl-dkms; NetworkManager manages the connection.'
      }
      trackpad = inputDevice 'Apple trackpad' {
        #confirmed
        description 'Primary pointing and gesture input device.'
      }
    }

    base = container 'Operating system' {
      description 'Arch Linux base system and system services.'
      arch = component 'Arch Linux' {
        #confirmed
        description 'Rolling-release GNU/Linux distribution; package management through pacman.'
      }
      kernel = component 'Linux kernel' {
        #confirmed
        description 'Linux kernel; exact version is machine-state data and should be refreshed when inventory is updated.'
      }
      kernelInput = kernelSubsystem 'Linux input subsystem' {
        #confirmed
        description 'Kernel input-event path between physical keyboard/touchpad devices and userspace input handling.'
      }
      systemd = component 'systemd' {
        #confirmed
        description 'System and service manager.'
      }
      pacman = component 'pacman' {
        #confirmed
        description 'Arch Linux package manager.'
      }
      networkManager = component 'NetworkManager' {
        #confirmed
        description 'Network connection management.'
      }
      broadcomDriver = component 'broadcom-wl-dkms' {
        #confirmed
        description 'Kernel driver package used by the Broadcom BCM4360 wireless adapter.'
      }
    }

    session = container 'Login and graphical session' {
      description 'Login manager, Wayland protocol and compositor.'
      greetd = component 'greetd' {
        #confirmed
        description 'Minimal login manager; starts the configured user session.'
      }
      wayland = component 'Wayland protocol' {
        #confirmed
        description 'Client/server display protocol and architecture. It is not itself a compositor process.'
      }
      niri = component 'niri compositor' {
        #confirmed
        description 'Scrollable-tiling Wayland compositor; acts as the Wayland server for graphical clients.'
      }
      libinput = inputProcessor 'libinput' {
        #to-verify
        description 'Input event processing used by niri; current installed package version needs a live check.'
      }
      niriConfig = configuration 'niri configuration' {
        #configured
        description 'KDL configuration at ~/.config/niri/config.kdl; includes keyboard, touchpad, gestures and key bindings.'
      }
      niriGestures = interactionMechanism 'niri native touchpad gestures' {
        #confirmed
        description 'Built-in three-finger vertical workspace switching, three-finger horizontal view movement and four-finger vertical overview toggle. These are compositor behaviors, not custom gesture-daemon mappings.'
      }
      niriKeyBindings = interactionMechanism 'niri keyboard bindings' {
        #configured
        description 'Bindings in config.kdl use Mod=Super; Super+Space launches fuzzel, Super+Return launches foot, Super+Slash launches foot with Fresh workflow, and Super+1..9 selects workspaces.'
      }
      workspaceNavigation = interactionMechanism 'Workspace and overview actions' {
        #confirmed
        description 'niri actions triggered by native touchpad gestures and configured keyboard bindings.'
      }
    }

    interaction = container 'Desktop interaction' {
      description 'Application launcher, terminal emulator and shell.'
      fuzzel = component 'fuzzel' {
        #confirmed
        description 'Wayland-native application launcher; invoked from the user’s niri workflow.'
      }
      foot = component 'foot' {
        #confirmed
        description 'Wayland-native terminal emulator; provides the terminal environment for shell and TUI applications.'
      }
      font = component 'Iosevka Nerd Font' {
        #configured
        description 'Preferred terminal font at 10pt; Nerd Font glyphs are used by terminal tools.'
      }
      footConfig = component 'foot configuration' {
        #configured
        description 'Configuration at ~/.config/foot/foot.ini. The user’s Iosevka Nerd Font 10pt preference and Sixel use are documented separately from a fresh config-file audit.'
      }
      bash = component 'Bash' {
        #confirmed
        description 'Interactive shell started inside foot.'
      }
      shellEnvironment = component 'Shell environment' {
        #to-verify
        description 'The dotfiles snapshot exports EDITOR=fresh and VISUAL=fresh in /etc/profile.d/99-editor.sh; this differs from the previously intended Neovim default and needs live reconciliation.'
      }
    }

    filesAndEditing = container 'File management and editing' {
      description 'Primary terminal file manager, editor, plugin integration and external openers.'
      yazi = component 'Yazi' {
        #confirmed
        description 'Primary terminal file manager; normally runs inside foot.'
      }
      nvim = component 'Neovim' {
        #confirmed
        description 'Configured text editor, with Lua configuration under ~/.config/nvim/.'
      }
      fresh = component 'Fresh editor' {
        #confirmed
        description 'Editor selected by EDITOR/VISUAL in the dotfiles snapshot and used by the niri workflow shortcut.'
      }
      lazy = component 'lazy.nvim' {
        #configured
        description 'Neovim plugin manager.'
      }
      yaziNvim = component 'yazi.nvim' {
        #configured
        description 'Neovim integration that launches Yazi in a Neovim terminal/floating interface.'
      }
      plenary = component 'plenary.nvim' {
        #supporting
        description 'Lua utility dependency used by the yazi.nvim integration.'
      }
      imv = component 'imv' {
        #confirmed
        description 'External image viewer; Yazi image opener is configured to use it.'
      }
      mpv = component 'mpv' {
        #configured
        description 'Video player selected by the Yazi video opener.'
      }
      xdgOpen = component 'xdg-open' {
        #supporting
        description 'Opens non-image files through the desktop MIME/application associations.'
      }
      file = component 'file' {
        #supporting
        description 'File type and MIME detection used by Yazi.'
      }
      firefox = component 'Firefox' {
        #confirmed
        description 'Web browser in the user’s desktop environment.'
      }
    }

    clipboard = container 'Clipboard and selection' {
      description 'Wayland clipboard utilities and selection integration.'
      wlClipboard = component 'wl-clipboard' {
        #configured
        description 'Provides wl-copy and wl-paste command-line utilities for Wayland clipboard access.'
      }
      primarySelection = component 'Wayland primary-selection protocol' {
        #to-verify
        description 'Selection-oriented clipboard behavior; the exact protocol path for the user’s trackpad tap workflow must be verified against the running compositor and applications.'
      }
    }

    preview = container 'Terminal preview and media tools' {
      description 'Yazi preview backends and helper utilities previously installed or selected.'
      sixel = component 'Sixel graphics protocol' {
        #configured
        description 'Terminal graphics protocol used by Yazi to display image previews in foot.'
      }
      chafa = component 'Chafa' {
        #supporting
        description 'Fallback terminal image renderer.'
      }
      ueberzug = component 'Überzug++' {
        #supporting
        description 'Alternative image preview backend; not the selected active path for Yazi inside foot.'
      }
      ffmpeg = component 'FFmpeg / ffprobe' {
        #supporting
        description 'Media metadata and video preview support.'
      }
      poppler = component 'Poppler / pdftoppm' {
        #supporting
        description 'PDF rendering for previews.'
      }
      imagemagick = component 'ImageMagick' {
        #supporting
        description 'Image format conversion and preview support.'
      }
      resvg = component 'resvg' {
        #supporting
        description 'SVG rendering support.'
      }
      archiveTools = component '7-Zip' {
        #supporting
        description 'Archive listing, extraction and preview support.'
      }
      searchTools = component 'fzf / ripgrep / jq' {
        #supporting
        description 'Search and structured-data helpers available to terminal workflows.'
      }
    }

    storage = container 'Data storage and synchronization' {
      description 'Local filesystems, the local configuration checkout, versioned remote repositories and optional network/cloud storage targets.'
      localFilesystem = filesystem 'Local Linux filesystem' {
        #to-verify
        description 'Local root and home data. Earlier inventory recorded an ext4 root partition and an APFS partition, but devices, mount points and current state have not been rechecked.'
      }
      dotfilesCheckout = repository 'Local dotfiles checkout' {
        #confirmed
        description 'Working copy at ~/dotfiles. Selected system configuration files are copied here, reviewed with Git diff, then explicitly committed and pushed.'
      }
      git = component 'Git' {
        #confirmed
        description 'Distributed version control used to review, commit, push and pull the dotfiles repository.'
      }
      cifsTools = storagePackage 'cifs-utils / smbclient' {
        #to-verify
        description 'SMB client and mount tooling appeared in an earlier package inventory; current installation and active use need verification.'
      }
      rsync = component 'rsync' {
        #to-verify
        description 'File transfer/synchronization utility present in an earlier package inventory; current workflows and endpoints are not yet identified.'
      }
      mountManager = component 'systemd mount and automount' {
        #supporting
        description 'systemd mount/automount units and fstab-generated mounts can connect local or remote filesystems. No active network mount definition was found in the reviewed dotfiles tree.'
      }
      cloudClient = component 'Cloud storage integration' {
        #to-verify
        description 'Provider and client are intentionally unspecified. No rclone, Syncthing or provider-specific configuration was identified in the reviewed dotfiles tree.'
      }
    }
  }

  github = softwareSystem 'GitHub' {
    description 'External Git hosting and shared archive service.'
    dotfilesRepo = repository 'devAItester/dotfiles' {
      #confirmed
      description 'Remote versioned source for selected workstation configuration files.'
    }
    aishareRepo = repository 'devAItester/aishare' {
      #confirmed
      description 'Remote shared archive for saved research and materials; also hosts the published AAC diagram.'
    }
  }

  networkShare = networkShare 'Network file share (endpoint not identified)' {
    #to-verify
    description 'Reserved model element for an SMB/NFS or other LAN share. No endpoint or active mount was confirmed in the reviewed dotfiles tree.'
  }

  cloudStorage = cloudStorage 'Cloud storage provider (not identified)' {
    #to-verify
    description 'Reserved model element for a future cloud drive/object-storage provider. No provider or active client configuration has been confirmed.'
  }

  user -> workstation.hardware.laptop 'uses'
  workstation.hardware.laptop -> workstation.base.arch 'runs'
  workstation.base.arch -> workstation.base.kernel 'is based on'
  workstation.base.arch -> workstation.base.pacman 'manages packages with'
  workstation.base.systemd -> workstation.session.greetd 'starts login service'
  workstation.base.systemd -> workstation.base.networkManager 'starts network service'
  workstation.base.kernel -> workstation.base.broadcomDriver 'loads kernel module'
  workstation.session.greetd -> workstation.session.niri 'starts configured session'
  workstation.session.niri -> workstation.session.wayland 'implements compositor side of'
  workstation.session.niri -> workstation.session.niriConfig 'is configured by'
  workstation.session.niri -> workstation.session.libinput 'uses for input event processing'
  workstation.session.libinput -> workstation.session.niri 'delivers normalized input events'
  workstation.session.niri -> workstation.session.niriGestures 'implements native touchpad gesture handling'
  workstation.session.niri -> workstation.session.niriKeyBindings 'dispatches configured key bindings'
  workstation.session.niriGestures -> workstation.session.workspaceNavigation 'triggers workspace and overview actions'
  workstation.session.niriKeyBindings -> workstation.session.workspaceNavigation 'invokes configured workspace actions'
  workstation.session.niriKeyBindings -> workstation.interaction.foot 'Super+Return launches terminal'
  workstation.session.niriKeyBindings -> workstation.interaction.fuzzel 'Super+Space launches application launcher'
  workstation.session.niriKeyBindings -> workstation.filesAndEditing.fresh 'Super+Slash launches Fresh workflow in foot'
  workstation.session.niri -> workstation.interaction.foot 'manages terminal window'
  workstation.session.niri -> workstation.interaction.fuzzel 'manages launcher window'
  workstation.session.niri -> workstation.filesAndEditing.imv 'manages image viewer window'
  workstation.session.niri -> workstation.filesAndEditing.firefox 'manages browser window'
  workstation.interaction.foot -> workstation.session.wayland 'connects as Wayland client'
  workstation.interaction.fuzzel -> workstation.session.wayland 'connects as Wayland client'
  workstation.filesAndEditing.imv -> workstation.session.wayland 'connects as Wayland client'

  workstation.interaction.foot -> workstation.interaction.footConfig 'is configured by'
  workstation.interaction.foot -> workstation.interaction.font 'renders text with'
  workstation.interaction.foot -> workstation.interaction.bash 'hosts shell'
  workstation.interaction.bash -> workstation.interaction.shellEnvironment 'reads'
  workstation.interaction.bash -> workstation.filesAndEditing.yazi 'launches'
  workstation.interaction.bash -> workstation.filesAndEditing.nvim 'launches'
  workstation.interaction.shellEnvironment -> workstation.filesAndEditing.fresh 'selects as EDITOR and VISUAL in dotfiles snapshot'
  workstation.filesAndEditing.yazi -> workstation.filesAndEditing.fresh 'opens text files through EDITOR'
  workstation.filesAndEditing.yazi -> workstation.filesAndEditing.mpv 'opens video files with'
  workstation.filesAndEditing.yazi -> workstation.preview.sixel 'renders terminal image previews with'
  workstation.preview.sixel -> workstation.interaction.foot 'is rendered by'
  workstation.filesAndEditing.yazi -> workstation.filesAndEditing.imv 'opens image files with'
  workstation.filesAndEditing.yazi -> workstation.filesAndEditing.xdgOpen 'opens other file types with'
  workstation.filesAndEditing.yazi -> workstation.filesAndEditing.file 'detects file types with'
  workstation.filesAndEditing.yazi -> workstation.interaction.shellEnvironment 'reads EDITOR and VISUAL'
  workstation.filesAndEditing.yazi -> workstation.preview.ffmpeg 'uses for media previews'
  workstation.filesAndEditing.yazi -> workstation.preview.poppler 'uses for PDF previews'
  workstation.filesAndEditing.yazi -> workstation.preview.imagemagick 'uses for image formats'
  workstation.filesAndEditing.yazi -> workstation.preview.resvg 'uses for SVG previews'
  workstation.filesAndEditing.yazi -> workstation.preview.archiveTools 'uses for archive previews'
  workstation.filesAndEditing.yazi -> workstation.preview.searchTools 'integrates with search helpers'
  workstation.filesAndEditing.yazi -> workstation.preview.chafa 'can use as fallback renderer'
  workstation.filesAndEditing.yazi -> workstation.preview.ueberzug 'has alternative preview backend'

  workstation.filesAndEditing.nvim -> workstation.filesAndEditing.lazy 'loads plugin manager'
  workstation.filesAndEditing.lazy -> workstation.filesAndEditing.yaziNvim 'loads'
  workstation.filesAndEditing.yaziNvim -> workstation.filesAndEditing.plenary 'uses dependency'
  workstation.filesAndEditing.yaziNvim -> workstation.filesAndEditing.yazi 'launches Yazi from Neovim'
  workstation.interaction.shellEnvironment -> workstation.filesAndEditing.fresh 'selects as EDITOR and VISUAL in dotfiles snapshot'

  workstation.filesAndEditing.nvim -> workstation.clipboard.wlClipboard 'uses for Wayland clipboard provider'
  workstation.clipboard.wlClipboard -> workstation.session.wayland 'connects through'
  workstation.clipboard.wlClipboard -> workstation.clipboard.primarySelection 'supports selection access through'
  workstation.hardware.keyboard -> workstation.base.kernelInput 'emits keyboard events'
  workstation.hardware.trackpad -> workstation.base.kernelInput 'emits touch and pointer events'
  workstation.base.kernel -> workstation.base.kernelInput 'provides input subsystem'
  workstation.base.kernelInput -> workstation.session.libinput 'exposes input events to'
  workstation.session.niriConfig -> workstation.hardware.keyboard 'sets XKB layout us,ru and Caps Lock group toggle'
  workstation.session.niriConfig -> workstation.hardware.trackpad 'enables tap-to-click and natural scrolling'
  workstation.session.niriConfig -> workstation.session.niriGestures 'disables hot corners; native swipe gestures remain built in'
  workstation.session.niriConfig -> workstation.session.niriKeyBindings 'defines Super-based key bindings'
  workstation.storage.localFilesystem -> workstation.storage.dotfilesCheckout 'stores local working copy'
  workstation.storage.git -> workstation.storage.dotfilesCheckout 'reads and updates'
  workstation.storage.git -> github.dotfilesRepo 'pushes and pulls versioned configuration'
  workstation.storage.mountManager -> networkShare 'can mount a configured network share'
  workstation.storage.cifsTools -> networkShare 'provides SMB client access when configured'
  workstation.storage.cloudClient -> cloudStorage 'provider integration not yet identified'
  workstation.filesAndEditing.yazi -> workstation.storage.localFilesystem 'browses local and mounted files'
  user -> github.aishareRepo 'stores shared research and saved material in'
  workstation.base.networkManager -> workstation.hardware.wifi 'manages connection'
  workstation.base.broadcomDriver -> workstation.hardware.wifi 'drives'
  workstation.base.arch -> workstation.base.networkManager 'provides network service'
}