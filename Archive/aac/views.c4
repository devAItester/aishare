views {
  view index {
    title 'Arch workstation — overview'
    description 'The whole software environment, from hardware and Arch Linux to Wayland, niri and daily applications.'
    include *
    autoLayout TopBottom
  }

  view session {
    title 'Boot and graphical session'
    description 'How the login manager starts niri and how Wayland clients attach to the compositor.'
    include workstation.hardware
    include workstation.base
    include workstation.session
    include workstation.interaction.fuzzel
    include workstation.interaction.foot
    include workstation.filesAndEditing.imv
    include workstation.filesAndEditing.firefox
    autoLayout TopBottom
  }

  view terminal-workflow {
    title 'Terminal and editing workflow'
    description 'foot hosts Bash; Bash launches Yazi and Neovim; Yazi previews through Sixel and integrates with external openers.'
    include workstation.session.niri
    include workstation.session.wayland
    include workstation.interaction
    include workstation.filesAndEditing
    include workstation.preview
    autoLayout TopBottom
  }

  view nvim-yazi {
    title 'Neovim and Yazi integration'
    description 'The standalone Yazi-in-foot path is distinct from the yazi.nvim path inside Neovim.'
    include workstation.session.wayland
    include workstation.interaction.foot
    include workstation.interaction.bash
    include workstation.filesAndEditing.yazi
    include workstation.filesAndEditing.nvim
    include workstation.filesAndEditing.lazy
    include workstation.filesAndEditing.yaziNvim
    include workstation.filesAndEditing.plenary
    include workstation.preview.sixel
    autoLayout TopBottom
  }

  view clipboard {
    title 'Clipboard and selection'
    description 'Wayland clipboard access is distinct from the PRIMARY selection path, which is triggered by pointer selection and still needs live provider verification.'
    include workstation.session.niri
    include workstation.session.wayland
    include workstation.interaction.foot
    include workstation.interaction.bash
    include workstation.filesAndEditing.nvim
    include workstation.clipboard
    include workstation.hardware.trackpad
    autoLayout TopBottom
  }

  view network {
    title 'Network hardware and service'
    description 'Broadcom Wi-Fi adapter, driver package and NetworkManager.'
    include workstation.hardware.wifi
    include workstation.base.arch
    include workstation.base.networkManager
    include workstation.base.broadcomDriver
    autoLayout TopBottom
  }

  view input {
    title 'Input devices, gestures and keyboard control'
    description 'Keyboard and trackpad events pass through the Linux input subsystem and libinput to niri. Niri handles native swipe gestures; config.kdl defines keyboard layout, touchpad behavior and Super-based bindings.'
    include workstation.hardware.keyboard
    include workstation.hardware.trackpad
    include workstation.base.kernel
    include workstation.base.kernelInput
    include workstation.session.libinput
    include workstation.session.niri
    include workstation.session.niriConfig
    include workstation.session.niriGestures
    include workstation.session.niriKeyBindings
    include workstation.session.workspaceNavigation
    include workstation.interaction.foot
    include workstation.interaction.footConfig
    include workstation.interaction.footKeyBindings
    include workstation.interaction.fuzzel
    include workstation.filesAndEditing.fresh
    include workstation.filesAndEditing.yazi
    include workstation.filesAndEditing.yaziConfig
    include workstation.filesAndEditing.yaziKeyBindings
    include workstation.filesAndEditing.nvim
    include workstation.filesAndEditing.nvimConfig
    include workstation.filesAndEditing.nvimKeyBindings
    include workstation.clipboard
    autoLayout TopBottom
  }

  view storage {
    title 'Local, shared and cloud storage'
    description 'Confirmed local dotfiles checkout and GitHub repositories are separated from unverified network-share and cloud-storage extension points.'
    include workstation.storage
    include workstation.filesAndEditing.yazi
    include workstation.base.systemd
    include github
    include networkShare
    include cloudStorage
    autoLayout TopBottom
  }
}

dynamic view trackpad-gesture-flow {
  title 'Trackpad gesture processing'
  description 'Native niri gesture path: three-finger vertical swipe changes workspace, three-finger horizontal swipe moves the view, and four-finger vertical swipe toggles overview. No separate gesture daemon or custom swipe mapping was found in the reviewed niri config.'
  workstation.hardware.trackpad
    -> workstation.base.kernelInput 'touch and pointer events'
    -> workstation.session.libinput 'normalized input events'
    -> workstation.session.niri 'gesture events'
    -> workstation.session.niriGestures 'recognizes native swipe'
    -> workstation.session.workspaceNavigation 'switches workspace, moves view or toggles overview'
}

dynamic view keyboard-shortcut-flow {
  title 'Keyboard shortcut dispatch'
  description 'Example from config.kdl: Super+Space launches fuzzel. Mod is configured as Super.'
  workstation.hardware.keyboard
    -> workstation.base.kernelInput 'key events'
    -> workstation.session.libinput 'input events'
    -> workstation.session.niri 'keyboard events'
    -> workstation.session.niriKeyBindings 'matches Super+Space'
    -> workstation.interaction.fuzzel 'launches'
}

dynamic view dotfiles-sync-flow {
  title 'Dotfiles repository synchronization'
  description 'The documented workflow separates local collection, diff review, explicit Git commit/publish and remote synchronization.'
  workstation.storage.localFilesystem
    -> workstation.storage.dotfilesCheckout 'contains working copy'
    -> workstation.storage.git 'review, commit and synchronize'
    -> github.dotfilesRepo 'push / pull'
}

dynamic view terminal-app-input-flow {
  title 'Terminal application input routing'
  description 'The keyboard event reaches niri and the focused terminal. foot handles its own shortcuts; other keys pass through the PTY to Bash and the active TUI application.'
  workstation.hardware.keyboard
    -> workstation.base.kernelInput 'key events'
    -> workstation.session.libinput 'input events'
    -> workstation.session.niri 'routes to focused Wayland client'
    -> workstation.interaction.foot 'terminal receives key events'
    -> workstation.filesAndEditing.yazi 'active TUI process receives PTY input'
    -> workstation.filesAndEditing.yaziKeyBindings 'applies keymap.toml bindings'
}

dynamic view nvim-clipboard-input-flow {
  title 'Neovim clipboard and pointer selection'
  description 'Neovim mappings distinguish the system clipboard (+) from PRIMARY selection (*); the latter is populated by mouse-selection release mappings.'
  workstation.hardware.keyboard
    -> workstation.base.kernelInput 'key events'
    -> workstation.session.libinput 'input events'
    -> workstation.session.niri 'routes to focused client'
    -> workstation.interaction.foot 'terminal'
    -> workstation.interaction.bash 'PTY'
    -> workstation.filesAndEditing.nvim 'editor'
    -> workstation.filesAndEditing.nvimKeyBindings 'Super/Alt mappings'
    -> workstation.clipboard.wlClipboard 'system clipboard via + register'
}

dynamic view primary-selection-flow {
  title 'Trackpad selection to PRIMARY'
  description 'The trackpad pointer event is delivered through the compositor and terminal mouse reporting to Neovim. The configured mouse-release mapping yanks the selection to the * register; the live clipboard provider path still needs verification.'
  workstation.hardware.trackpad
    -> workstation.base.kernelInput 'pointer events'
    -> workstation.session.libinput 'input events'
    -> workstation.session.niri 'routes pointer input to focused client'
    -> workstation.interaction.foot 'terminal mouse reporting'
    -> workstation.filesAndEditing.nvim 'mouse input'
    -> workstation.filesAndEditing.nvimKeyBindings 'LeftRelease / 2-LeftRelease mapping'
    -> workstation.clipboard.primarySelection 'writes selected text to PRIMARY'
}
